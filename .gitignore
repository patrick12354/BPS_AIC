# --- Data (bagian 31.1: data/raw, interim, processed TIDAK di-commit) ---
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
# Pengecualian: baseline kategori dibaca saat MELAYANI request, bukan artefak pipeline antara.
# Ia juga tidak dapat dibuat ulang oleh orang luar karena data mentahnya memang tidak
# didistribusikan - tanpa berkas ini, `docker compose up` gagal build dan fitur BEN-01 hilang
# diam-diam. Isinya agregat proporsi per kategori, tidak memuat teks ulasan mana pun.
!data/processed/category_baseline.json

# --- Model artifacts (bagian 31.1: tidak di-commit, diunduh via script) ---
models/
*.safetensors
*.gguf
*.onnx
*.bin
*.pt
*.pth
.cache/
.huggingface/

# --- Secrets & config lokal ---
.env
.env.local
*.local.yaml

# --- Dokumen referensi biner (sumber .md tetap di-commit) ---
docs/reference/*.pdf
docs/reference/*.docx

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml

# --- Node / frontend ---
node_modules/
dist/
build/
.vite/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Sesi runtime (session-only storage, bagian 27.2 / ADR-010) ---
apps/api/tmp/
tmp/
sessions/

# --- Editor & OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Log training (dihasilkan ulang saat menjalankan script)
ml/evaluation/*.log

# Dependensi & build frontend
node_modules/
apps/web/dist/
data/annotation/label.html

# Konfigurasi alat pengembangan lokal - tidak relevan bagi siapa pun yang meng-clone.
.claude/
.vscode/
.idea/

# Pengecualian: kepala aspek v2 (L0') adalah artefak KECIL (~36 KB) yang sengaja dilacak git,
# berbeda dari checkpoint 499 MB. Ia dibaca saat melayani request dan dibakar ke image lewat
# COPY ml/. Tanpa baris ini, artefak tidak pernah sampai ke repositori maupun ke container.
!ml/text/artifacts/*.pt
